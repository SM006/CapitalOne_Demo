# ==============================================================================
# Capital One Demo .gitignore
# ==============================================================================

# Operating System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Configurations
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Secrets, Credentials & Local Environment
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt
*.id_rsa
*.id_ed25519
credentials
credentials.*
credentials.backup*
*.bak
*.bak.*
*.backup*
.aws/
canary_keys.txt
secret_token.txt

# Runtime Logs, Process IDs & Buffers
logs_mac/
logs_live/
*.stdout
*.stderr
*.pid
*.tmp
/tmp/
*.log

# Allow Curated Baseline Reference Logs
!logs/
!logs/.gitkeep
!logs/*.log

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/

# Node & Web Build Residue (if built locally)
node_modules/
.vite/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
